{
  "name": "tagme-server",
  "version": "0.1.0",
  "private": true,
  "description": "응급안심 백엔드 + 응급 지원 웹",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite build --watch",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "vite build",
    "start": "node dist/src/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "aed:sync": "tsx scripts/aed-sync.ts",
    "test": "npm run build:web && tsx scripts/run-tests.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "express": "^5.3.0",
    "firebase-admin": "^13.10.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
