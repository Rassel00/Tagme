# 서버 포트 (Render는 PORT를 자동 주입)
PORT=3000

# 외부에서 접근하는 주소. 태그 URL·승인 링크·문자 본문에 사용 (끝에 / 없이)
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL 연결 문자열 (Neon 콘솔 Connect). sslmode=require 대신 verify-full 사용 (pg 경고 방지)
DATABASE_URL=

# 게이트웨이 앱이 X-Gateway-Key 헤더로 보내는 고정 키 (D2에서 사용)
GATEWAY_KEY=

# 게이트웨이 폰 번호. 신고자 본인 확인 sms: 링크에 사용 (D4~D6에서 사용)
GATEWAY_PHONE=

# 공공데이터포털 AED 정보 API 키 (D6에서 사용)
AED_API_KEY=

# 카카오맵 JavaScript 키 (Kakao Developers > 내 애플리케이션 > 앱 키). 브라우저에 노출되는 공개 키이며
# 앱 설정 > 플랫폼 > Web 에 등록한 도메인에서만 동작한다. 비우면 주변 AED 는 약식 지도로 표시
KAKAO_JS_KEY=

# Firebase 서비스 계정 키 JSON (한 줄 문자열, D2에서 사용)
FIREBASE_SERVICE_ACCOUNT=

# 통합 테스트용 DB (npm test 가 임시 스키마를 만들고 지움). Neon 은 -pooler 가 없는 direct 주소. 비우면 통합 테스트 건너뜀
TEST_DATABASE_URL=
