# 서버 포트 (Render는 PORT를 자동 주입)
PORT=3000

# 외부에서 접근하는 주소. 태그 URL·승인 링크·문자 본문에 사용 (끝에 / 없이)
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL 연결 문자열 (Neon). 예: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# 게이트웨이 앱이 X-Gateway-Key 헤더로 보내는 고정 키 (D2에서 사용)
GATEWAY_KEY=

# 게이트웨이 폰 번호. 신고자 본인 확인 sms: 링크에 사용 (D4~D6에서 사용)
GATEWAY_PHONE=

# 공공데이터포털 AED 정보 API 키 (D6에서 사용)
AED_API_KEY=

# Firebase 서비스 계정 키 JSON (한 줄 문자열, D2에서 사용)
FIREBASE_SERVICE_ACCOUNT=
